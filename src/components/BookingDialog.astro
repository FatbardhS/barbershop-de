---
import { shop, services, barbers, booking } from "../data/shop";
import { url } from "../lib/url";

const anyBarber = "Egal";
---

<dialog
  id="termin"
  aria-labelledby="termin-title"
  class="m-0 h-dvh max-h-none w-full max-w-none overflow-hidden bg-cream p-0 open:flex open:flex-col text-ink backdrop:bg-ink/60 sm:m-auto sm:h-fit sm:max-h-[90dvh] sm:w-[32rem] sm:rounded-xl"
  data-email={booking.email}
  data-phone={shop.phone}
  data-shop={shop.name}
  data-hours={JSON.stringify(booking.openingHours)}
  data-slot-minutes={booking.slotMinutes}
  data-days-ahead={booking.daysAhead}
  data-barbers={JSON.stringify(barbers.map((barber) => barber.name))}
  data-supabase-url={booking.supabaseUrl}
  data-supabase-key={booking.supabaseAnonKey}
>
  <form class="flex min-h-0 flex-auto flex-col" novalidate>
    <header class="flex items-center gap-3 border-b border-line px-5 py-4">
      <button type="button" data-back hidden class="text-xl leading-none hover:text-brass-dark" aria-label="Zurück">←</button>
      <h2 id="termin-title" class="flex-1 text-xl font-bold">Termin buchen</h2>
      <button type="button" data-close class="text-xl leading-none hover:text-brass-dark" aria-label="Schließen">✕</button>
    </header>

    <div class="min-h-0 flex-auto overflow-y-auto px-5 py-6">
      <div data-step="choose" class="space-y-8">
        <fieldset class="min-w-0">
          <legend class="step-label">1 · Leistung</legend>
          <div class="mt-3 grid gap-2">
            {services.map((service, i) => (
              <label class="option flex items-center justify-between gap-4 px-4 py-3">
                <input type="radio" name="service" value={service.name} data-price={service.price} data-duration={service.duration} class="sr-only" checked={i === 0} />
                <span>
                  <span class="block font-semibold">{service.name}</span>
                  <span class="text-xs text-muted">{service.duration} Min.</span>
                </span>
                <span class="font-display text-lg font-semibold text-brass-dark">{service.price}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="min-w-0">
          <legend class="step-label">2 · Barbier</legend>
          <div class="mt-3 grid grid-cols-4 gap-2">
            <label class="option flex flex-col items-center gap-2 px-1 py-3 text-center">
              <input type="radio" name="barber" value={anyBarber} class="sr-only" checked />
              <span class="flex size-11 items-center justify-center rounded-full bg-sand font-display text-lg font-semibold text-brass-dark">?</span>
              <span class="text-xs font-medium">Egal</span>
            </label>
            {barbers.map((barber) => (
              <label class="option flex flex-col items-center gap-2 px-1 py-3 text-center">
                <input type="radio" name="barber" value={barber.name} class="sr-only" />
                <img src={barber.image} alt="" width="44" height="44" class="size-11 rounded-full object-cover" />
                <span class="w-full truncate text-xs font-medium">{barber.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="min-w-0">
          <legend class="step-label">3 · Tag</legend>
          <div data-days class="-mx-5 mt-3 flex gap-2 overflow-x-auto px-5 pb-1"></div>
        </fieldset>

        <fieldset class="min-w-0">
          <legend class="step-label">4 · Uhrzeit</legend>
          <p data-slots-status hidden class="mt-3 text-sm text-muted"></p>
          <div data-slots class="mt-3 grid grid-cols-4 gap-2"></div>
        </fieldset>
      </div>

      <div data-step="details" hidden class="space-y-6">
        <div class="rounded-lg bg-sand px-4 py-3 text-sm">
          <p class="step-label">Ihr Termin</p>
          <p data-summary class="mt-2 font-medium"></p>
        </div>
        <label class="block">
          <span class="text-sm font-semibold">Name</span>
          <input type="text" name="name" autocomplete="name" placeholder="Max Mustermann" class="field" />
          <span data-error-for="name" hidden class="mt-1 block text-sm text-red-700">Geben Sie Ihren Namen ein.</span>
        </label>
        <label class="block">
          <span class="text-sm font-semibold">Telefonnummer</span>
          <input type="tel" name="phone" autocomplete="tel" placeholder="0151 23456789" class="field" />
          <span data-error-for="phone" hidden class="mt-1 block text-sm text-red-700">Geben Sie eine gültige Telefonnummer ein.</span>
        </label>
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <p class="text-xs text-muted">
          Wir nutzen Ihre Angaben nur, um Ihren Termin zu bestätigen. Mehr in der
          <a href={url("/datenschutz")} class="text-brass-dark underline hover:text-ink">Datenschutzerklärung</a>.
        </p>
      </div>

      <div data-step="done" hidden class="py-10 text-center">
        <div class="mx-auto flex size-14 items-center justify-center rounded-full bg-brass text-2xl text-white">✓</div>
        <h3 data-done-title class="mt-5 text-2xl font-bold">Anfrage gesendet</h3>
        <p data-done-text class="mx-auto mt-2 max-w-xs text-muted">
          Danke! Wir melden uns telefonisch bei Ihnen, um den Termin zu bestätigen.
        </p>
        <p data-summary class="mt-4 text-sm font-medium"></p>
      </div>
    </div>

    <footer class="border-t border-line px-5 py-4">
      <p data-error hidden class="mb-3 text-sm text-red-700"></p>
      <div data-footer-info class="mb-3 flex items-center justify-between gap-4 text-sm">
        <span data-footer-summary class="text-muted"></span>
        <span data-footer-price class="font-display text-lg font-semibold text-brass-dark"></span>
      </div>
      <button type="submit" data-submit class="btn-primary w-full disabled:cursor-wait disabled:opacity-60">Weiter</button>
    </footer>
  </form>
</dialog>

<script>
  const dialog = document.getElementById("termin") as HTMLDialogElement | null;

  if (dialog) {
    const form = dialog.querySelector("form")!;
    const daysBox = dialog.querySelector<HTMLElement>("[data-days]")!;
    const slotsBox = dialog.querySelector<HTMLElement>("[data-slots]")!;
    const slotsStatus = dialog.querySelector<HTMLElement>("[data-slots-status]")!;
    const steps = {
      choose: dialog.querySelector<HTMLElement>('[data-step="choose"]')!,
      details: dialog.querySelector<HTMLElement>('[data-step="details"]')!,
      done: dialog.querySelector<HTMLElement>('[data-step="done"]')!,
    };
    const backButton = dialog.querySelector<HTMLButtonElement>("[data-back]")!;
    const submitButton = dialog.querySelector<HTMLButtonElement>("[data-submit]")!;
    const errorBox = dialog.querySelector<HTMLElement>("[data-error]")!;
    const footerInfo = dialog.querySelector<HTMLElement>("[data-footer-info]")!;
    const footerSummary = dialog.querySelector<HTMLElement>("[data-footer-summary]")!;
    const footerPrice = dialog.querySelector<HTMLElement>("[data-footer-price]")!;

    const openingHours: ([string, string] | null)[] = JSON.parse(dialog.dataset.hours ?? "[]");
    const slotMinutes = Number(dialog.dataset.slotMinutes);
    const daysAhead = Number(dialog.dataset.daysAhead);
    const barberNames: string[] = JSON.parse(dialog.dataset.barbers ?? "[]");
    const supabaseUrl = dialog.dataset.supabaseUrl ?? "";
    const supabaseKey = dialog.dataset.supabaseKey ?? "";
    // Without a Supabase project, slots aren't blocked and requests are only emailed
    const storesBookings = Boolean(supabaseUrl && supabaseKey);

    const pad = (n: number) => String(n).padStart(2, "0");
    const toMinutes = (time: string) => {
      const [h, m] = time.split(":").map(Number);
      return h * 60 + m;
    };
    const isoDate = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    const fromIso = (iso: string) => {
      const [y, m, d] = iso.split("-").map(Number);
      return new Date(y, m - 1, d);
    };
    // Supabase returns local shop time like "2026-10-23T15:30:00"
    const parseLocal = (timestamp: string) => {
      const [date, time] = timestamp.split(/[T ]/);
      const [y, m, d] = date.split("-").map(Number);
      const [h, min] = time.split(":").map(Number);
      return new Date(y, m - 1, d, h, min).getTime();
    };
    const weekdayShort = new Intl.DateTimeFormat("de-DE", { weekday: "short" });
    const dateShort = new Intl.DateTimeFormat("de-DE", { weekday: "short", day: "numeric", month: "short" });
    const dateLong = new Intl.DateTimeFormat("de-DE", { weekday: "long", day: "numeric", month: "long", year: "numeric" });

    const value = (name: string) => (form.elements.namedItem(name) as RadioNodeList | HTMLInputElement | null)?.value ?? "";
    const duration = () =>
      Number(form.querySelector<HTMLInputElement>('input[name="service"]:checked')?.dataset.duration ?? slotMinutes);

    let busy: { barber: string; start: number; end: number }[] = [];
    let busyState: "off" | "loading" | "ready" | "failed" = storesBookings ? "loading" : "off";

    async function rpc<T>(fn: string, body: object): Promise<T> {
      const headers: Record<string, string> = { apikey: supabaseKey, "Content-Type": "application/json" };
      // Legacy anon keys are JWTs and go in Authorization too; new publishable keys don't
      if (!supabaseKey.startsWith("sb_")) headers.Authorization = `Bearer ${supabaseKey}`;
      const response = await fetch(`${supabaseUrl}/rest/v1/rpc/${fn}`, { method: "POST", headers, body: JSON.stringify(body) });
      const data = await response.json().catch(() => null);
      if (!response.ok) throw new Error(data?.message ?? response.statusText);
      return data as T;
    }

    async function loadBusy() {
      if (!storesBookings) return;
      busyState = "loading";
      renderSlots();
      const today = new Date();
      const last = new Date(today);
      last.setDate(today.getDate() + daysAhead);
      try {
        const rows = await rpc<{ barber: string; starts_at: string; ends_at: string }[]>("busy_slots", {
          from_date: isoDate(today),
          to_date: isoDate(last),
        });
        busy = rows.map((row) => ({ barber: row.barber, start: parseLocal(row.starts_at), end: parseLocal(row.ends_at) }));
        busyState = "ready";
      } catch (error) {
        console.warn("Belegte Zeiten konnten nicht geladen werden:", error);
        busyState = "failed";
      }
      renderSlots();
    }

    function isTaken(start: number, minutes: number) {
      const end = start + minutes * 60_000;
      const barber = value("barber");
      const candidates = barber === "Egal" ? barberNames : [barber];
      return candidates.every((name) => busy.some((b) => b.barber === name && b.start < end && start < b.end));
    }

    function slotsFor(day: Date, minutes: number) {
      const open = openingHours[day.getDay()];
      if (!open) return [];
      const now = Date.now();
      const slots: { time: string; past: boolean; taken: boolean }[] = [];
      for (let m = toMinutes(open[0]); m + minutes <= toMinutes(open[1]); m += slotMinutes) {
        const start = new Date(day);
        start.setHours(Math.floor(m / 60), m % 60, 0, 0);
        slots.push({
          time: `${pad(start.getHours())}:${pad(start.getMinutes())}`,
          past: start.getTime() <= now,
          taken: isTaken(start.getTime(), minutes),
        });
      }
      return slots;
    }

    function renderDays() {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const selected = value("day");
      const days: string[] = [];
      for (let i = 0; i < daysAhead; i++) {
        const day = new Date(today);
        day.setDate(today.getDate() + i);
        if (slotsFor(day, duration()).some((slot) => !slot.past)) days.push(isoDate(day));
      }
      // Keep the chosen day when the list is redrawn (e.g. after changing the service)
      const checkedDay = days.includes(selected) ? selected : days[0];
      daysBox.innerHTML = days
        .map((iso) => {
          const day = fromIso(iso);
          return `<label class="option flex w-16 shrink-0 flex-col items-center py-2">
            <input type="radio" name="day" value="${iso}" class="sr-only" ${iso === checkedDay ? "checked" : ""} />
            <span class="text-[11px] font-semibold uppercase">${weekdayShort.format(day).replace(".", "")}</span>
            <span class="font-display text-2xl font-semibold">${day.getDate()}</span>
          </label>`;
        })
        .join("");
    }

    function renderSlots() {
      const iso = value("day");
      const selected = value("time");
      const slots = iso ? slotsFor(fromIso(iso), duration()) : [];
      const loading = busyState === "loading";
      slotsBox.innerHTML = slots
        .map((slot) => {
          const disabled = slot.past || slot.taken || loading;
          const checked = !disabled && slot.time === selected;
          return `<label class="option py-2.5 text-center text-sm font-semibold"${slot.taken && !slot.past ? ' title="Bereits vergeben"' : ""}>
            <input type="radio" name="time" value="${slot.time}" class="sr-only" ${disabled ? "disabled" : ""} ${checked ? "checked" : ""} />
            ${slot.time}
          </label>`;
        })
        .join("");

      const noneFree = !loading && slots.length > 0 && slots.every((slot) => slot.past || slot.taken);
      const status =
        loading ? "Freie Zeiten werden geladen…"
        : busyState === "failed" ? "Belegte Zeiten konnten nicht geladen werden. Sie können trotzdem anfragen."
        : noneFree ? "An diesem Tag ist nichts mehr frei. Wählen Sie einen anderen Tag oder Barbier."
        : "";
      slotsStatus.textContent = status;
      slotsStatus.hidden = !status;
    }

    function summary() {
      const iso = value("day");
      const barber = value("barber");
      const parts = [value("service"), barber === "Egal" ? "beliebiger Barbier" : `bei ${barber}`];
      const when = iso ? `${dateShort.format(fromIso(iso))}${value("time") ? `, ${value("time")} Uhr` : ""}` : "";
      return { line: `${parts.join(" ")} · ${when}`, when };
    }

    function updateFooter() {
      const service = form.querySelector<HTMLInputElement>('input[name="service"]:checked');
      footerSummary.textContent = `${value("service")} · ${summary().when}`;
      footerPrice.textContent = service?.dataset.price ?? "";
    }

    function showStep(step: keyof typeof steps, summaryLine = summary().line) {
      for (const [name, el] of Object.entries(steps)) el.hidden = name !== step;
      backButton.hidden = step !== "details";
      footerInfo.hidden = step === "done";
      submitButton.disabled = false;
      submitButton.textContent = { choose: "Weiter", details: storesBookings ? "Termin buchen" : "Termin anfragen", done: "Schließen" }[step];
      errorBox.hidden = true;
      dialog!.querySelectorAll<HTMLElement>("[data-summary]").forEach((el) => (el.textContent = summaryLine));
      form.querySelector(".overflow-y-auto")?.scrollTo(0, 0);
      currentStep = step;
    }

    function showError(message: string) {
      errorBox.textContent = message;
      errorBox.hidden = false;
    }

    function fieldError(name: string, show: boolean) {
      dialog!.querySelector<HTMLElement>(`[data-error-for="${name}"]`)!.hidden = !show;
    }

    let currentStep: keyof typeof steps = "choose";

    function open(barber?: string) {
      form.reset();
      daysBox.innerHTML = "";
      if (barber) {
        const input = form.querySelector<HTMLInputElement>(`input[name="barber"][value="${CSS.escape(barber)}"]`);
        if (input) input.checked = true;
      }
      renderDays();
      renderSlots();
      fieldError("name", false);
      fieldError("phone", false);
      showStep("choose");
      updateFooter();
      if (!dialog!.open) dialog!.showModal();
      loadBusy();
    }

    document.querySelectorAll<HTMLElement>("[data-booking]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        open(trigger.dataset.barber);
      });
    });

    form.addEventListener("change", (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name === "service") renderDays();
      if (target.name === "day" || target.name === "service" || target.name === "barber") renderSlots();
      if (target.name === "time") errorBox.hidden = true;
      if (target.name === "name" || target.name === "phone") fieldError(target.name, false);
      updateFooter();
    });

    form.addEventListener("input", (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name === "name" || target.name === "phone") fieldError(target.name, false);
    });

    backButton.addEventListener("click", () => showStep("choose"));
    dialog.querySelector("[data-close]")!.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    async function sendEmail(fields: Record<string, string>) {
      const response = await fetch(`https://formsubmit.co/ajax/${dialog!.dataset.email}`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ _template: "table", _honey: value("_honey"), ...fields }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || String(result.success) !== "true") throw new Error(result.message);
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (currentStep === "done") {
        dialog.close();
        return;
      }

      if (currentStep === "choose") {
        if (!value("time")) {
          showError("Wählen Sie eine Uhrzeit aus.");
          return;
        }
        showStep("details");
        return;
      }

      const name = value("name").trim();
      const phone = value("phone").trim();
      const nameOk = name.length >= 2;
      const phoneOk = phone.replace(/\D/g, "").length >= 6;
      fieldError("name", !nameOk);
      fieldError("phone", !phoneOk);
      if (!nameOk || !phoneOk) return;
      if (value("_honey")) return;

      const iso = value("day");
      const time = value("time");
      const date = dateLong.format(fromIso(iso));
      let barber = value("barber");
      submitButton.disabled = true;
      submitButton.textContent = "Wird gesendet…";
      errorBox.hidden = true;

      if (storesBookings) {
        try {
          barber = await rpc<string>("book_slot", {
            p_starts_at: `${iso}T${time}:00`,
            p_duration: duration(),
            p_barber: barber,
            p_barbers: barberNames,
            p_service: value("service"),
            p_name: name,
            p_phone: phone,
          });
        } catch (error) {
          const message = error instanceof Error ? error.message : "";
          submitButton.disabled = false;
          submitButton.textContent = "Termin buchen";
          if (message.includes("slot_taken") || message.includes("slot_in_past")) {
            showStep("choose");
            showError("Diese Uhrzeit wurde gerade vergeben. Wählen Sie bitte eine andere.");
            await loadBusy();
          } else {
            console.warn("Termin konnte nicht gespeichert werden:", error);
            showError(`Der Termin konnte nicht gebucht werden. Rufen Sie uns gern an: ${dialog.dataset.phone}`);
          }
          return;
        }
      }

      const summaryLine = `${value("service")} bei ${barber === "Egal" ? "beliebigem Barbier" : barber} · ${dateShort.format(fromIso(iso))}, ${time} Uhr`;
      try {
        await sendEmail({
          _subject: `${storesBookings ? "Neuer Termin" : "Neue Terminanfrage"}: ${name}, ${date}, ${time} Uhr`,
          Name: name,
          Telefon: phone,
          Leistung: value("service"),
          Barbier: barber,
          Datum: date,
          Uhrzeit: `${time} Uhr`,
        });
      } catch (error) {
        console.warn("E-Mail an den Shop fehlgeschlagen:", error);
        // The slot is already saved, so the booking still counts
        if (!storesBookings) {
          submitButton.disabled = false;
          submitButton.textContent = "Termin anfragen";
          showError(`Die Anfrage konnte nicht gesendet werden. Rufen Sie uns gern an: ${dialog.dataset.phone}`);
          return;
        }
      }

      dialog.querySelector("[data-done-title]")!.textContent = storesBookings ? "Termin gebucht" : "Anfrage gesendet";
      dialog.querySelector("[data-done-text]")!.textContent = storesBookings
        ? "Danke! Ihr Termin ist für Sie reserviert. Wir melden uns, falls es Rückfragen gibt."
        : "Danke! Wir melden uns telefonisch bei Ihnen, um den Termin zu bestätigen.";
      showStep("done", summaryLine);
    });

    if (location.hash === "#termin") open();
  }
</script>
