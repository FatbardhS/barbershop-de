---
import { shop, hours } from "../data/shop";
---

<section id="visit" class="scroll-mt-16">
  <div class="container-page grid gap-10 py-16 md:grid-cols-2 md:py-20">
    <div>
      <h2 class="text-3xl font-bold sm:text-4xl">Visit us</h2>
      <address class="mt-6 not-italic text-muted">
        {shop.address}<br />
        {shop.postcode}<br />
        <a href={`tel:${shop.phone}`} class="hover:text-brass-dark">{shop.phone}</a>
      </address>
      <dl class="mt-8 max-w-xs divide-y divide-line border-y border-line text-sm">
        {hours.map((row) => (
          <div class="flex justify-between py-3">
            <dt class="font-medium">{row.days}</dt>
            <dd class="text-muted">{row.time}</dd>
          </div>
        ))}
      </dl>
      <a href={shop.bookingUrl} class="btn-primary mt-8">Book now</a>
    </div>
    {shop.mapEmbedUrl ? (
      <iframe
        src={shop.mapEmbedUrl}
        class="aspect-[4/3] w-full rounded-lg border-0"
        loading="lazy"
        title={`Map to ${shop.name}`}
      ></iframe>
    ) : (
      <div class="photo-placeholder flex aspect-[4/3] items-end rounded-lg p-4">
        <span class="text-xs uppercase tracking-widest text-muted">Map</span>
      </div>
    )}
  </div>
</section>
