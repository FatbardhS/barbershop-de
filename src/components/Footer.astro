---
import { shop } from "../data/shop";
import { url } from "../lib/url";
import Logo from "./Logo.astro";
---

<footer class="bg-ink text-cream/70">
  <div class="container-page flex flex-wrap items-center justify-between gap-6 py-10 text-sm">
    <div class="flex flex-col gap-3">
      <Logo inverted />
      <p>© {new Date().getFullYear()} {shop.name}</p>
    </div>
    <nav class="flex flex-wrap gap-6">
      <a href={url("/impressum")} class="hover:text-brass">Impressum</a>
      <a href={url("/datenschutz")} class="hover:text-brass">Datenschutz</a>
      <a href={shop.instagram} class="hover:text-brass">Instagram</a>
    </nav>
  </div>
</footer>
