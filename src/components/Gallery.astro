---
import { gallery, shop } from "../data/shop";
---

<section id="gallery" class="scroll-mt-16 border-b border-line bg-sand">
  <div class="container-page py-16 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-3xl font-bold sm:text-4xl">Unsere Arbeiten</h2>
      <a href={shop.instagram} class="text-sm font-semibold text-brass-dark hover:text-ink">Folgen Sie uns auf Instagram →</a>
    </div>
    <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {gallery.map((item) => (
        <li class="relative overflow-hidden rounded-md">
          <img
            src={item.image}
            alt={`Frisur: ${item.label}`}
            width="400"
            height="400"
            loading="lazy"
            class="aspect-square w-full object-cover"
          />
          <span class="absolute bottom-2 left-2 rounded bg-cream/90 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-widest text-ink">
            {item.label}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
